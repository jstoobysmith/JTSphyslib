open GaugeWeightDecomposition

lemma massWeightSubmodule_two_eq :
    h.massWeightSubmodule 2 = h.higgsSubmodule 0 ⊔ h.barHiggsSubmodule 0 := by
  rw [h.massWeightSubmodule_eq 2 (by decide)]
