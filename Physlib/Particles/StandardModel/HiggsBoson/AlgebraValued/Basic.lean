        rw [Submodule.span_le, Set.singleton_subset_iff] <;>
        exact Module.End.mem_eigenspace_iff.mpr
          (by rw [h.rep_gaugeSU2Perm_higgsBarHiggs_add, su2PermSign_zero, one_smul])
