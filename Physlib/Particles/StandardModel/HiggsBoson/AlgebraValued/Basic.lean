    mul_assoc, hbh2, hhh2, hbb2, ← sup_assoc, sup_idem, sup_right_idem]
  have hswap : ∀ a : Fin 2, (⨆ i : Fin 1 → Fin 1 ⊕ Fin 3, ⨆ j : Fin 1 → Fin 1 ⊕ Fin 3,
