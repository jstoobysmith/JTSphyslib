      · rw [List.map_append, List.sum_append]
        omega
      · rw [tmul_mul_tmul, List.map_append, List.prod_append]
    | zero => rw [hz₂]; exact zero_mem _
    | add u v hu hv ihu ihv => rw [hd₂]; exact add_mem ihu ihv
