  have hd₁ : ∀ u v w : JetAlgebra, (u + v) * w = u * w + v * w := by grind
  have hd₂ : ∀ u v w : JetAlgebra, u * (v + w) = u * v + u * w := by grind
  have hz₁ : ∀ u : JetAlgebra, 0 * u = 0 := fun u => zero_mul u
