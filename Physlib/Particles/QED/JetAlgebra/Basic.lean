lemma covariantStep_mem_oddLow (μ : Fin 1 ⊕ Fin 3) {d : ℕ} {x : JetAlgebra}
    (hx : x ∈ oddLow d) : covariantStep μ x ∈ oddLow (d + 1) := by
  have hone : ∀ y : LeptonSinglet.JetAlgebra, 1 * y = y := fun y => one_mul y
